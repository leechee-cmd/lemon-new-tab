{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "web/**/*",
    "entrypoints/newtab/**/*",
    "shared/**/*",
    "types/**/*"
  ],
  "exclude": [".output", "scripts/**/*", "web/vite.config.ts", "web/shared.ts"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "types": ["vite/client"],

    "paths": {
      "@/*": ["./*"],
      "@newtab/*": ["./entrypoints/newtab/*"],
      "#imports": ["./web/shims/imports.ts"]
    },
    "jsx": "preserve",
    "jsxImportSource": "vue",

    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  }
}
