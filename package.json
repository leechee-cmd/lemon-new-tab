{
  "name": "lemon-new-tab",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts",
    "type-check": "run-s type-check:web type-check:functions",
    "type-check:web": "vue-tsc -p tsconfig.web.json --noEmit",
    "type-check:functions": "tsc -p tsconfig.functions.json --noEmit",
    "typecheck:web": "vue-tsc -p tsconfig.web.json --noEmit",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint:style": "stylelint **/*.{css,scss,sass,less,vue,html} --fix --ignore-path .gitignore",
    "lint:check:oxlint": "oxlint . -D correctness --ignore-path .gitignore",
    "lint:check:eslint": "eslint .",
    "lint:check:style": "stylelint **/*.{css,scss,sass,less,vue,html} --ignore-path .gitignore",
    "lint:check": "run-s lint:check:oxlint lint:check:eslint lint:check:style",
    "lint": "run-s lint:oxlint lint:eslint lint:style",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@dnd-kit/vue": "^0.5.0",
    "@vueuse/components": "^14.4.0",
    "@vueuse/core": "^14.4.0",
    "dayjs": "^1.11.21",
    "dayjs-plugin-lunar": "^1.4.1",
    "element-plus": "^2.14.4",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-vue": "^5.4.0",
    "idb": "^8.0.3",
    "pinia": "^4.0.2",
    "vue": "rc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@iconify-json/ant-design": "^1.2.8",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/fluent": "^1.2.54",
    "@iconify-json/ic": "^1.2.4",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.77.0",
    "eslint-plugin-vue": "^10.10.0",
    "markdown-exit": "latest",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "postcss": "^8.5.26",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-markdown": "^32.0.0",
    "vite": "^8.2.1",
    "vite-plugin-i18next-loader": "^4.1.0",
    "vite-svg-loader": "^5.1.1",
    "vue-tsc": "^3.3.9"
  }
}
